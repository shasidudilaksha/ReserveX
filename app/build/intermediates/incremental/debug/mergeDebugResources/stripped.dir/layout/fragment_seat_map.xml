<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F6F3F9">
  <LinearLayout android:id="@+id/headerBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR SPACE TO FOCUS" android:textSize="11sp" android:textColor="#857594" android:letterSpacing="0.12" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose your seat" android:textSize="28sp" android:textColor="#302443" android:textStyle="bold" android:layout_marginTop="6dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="#6650A4" android:id="@+id/textViewAreaName" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#706C80" android:id="@+id/tvVisitDetails" android:layout_marginTop="6dp" />
    <LinearLayout android:id="@+id/layoutLegend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="● Available" android:textSize="12sp" android:textColor="#27755A" android:layout_weight="1" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="● Selected" android:textSize="12sp" android:textColor="#7051AA" android:layout_weight="1" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="● Reserved" android:textSize="12sp" android:textColor="#9D6370" android:layout_weight="1" />
    </LinearLayout>
  </LinearLayout>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="16dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="#FFFFFF" app:strokeWidth="1dp" app:strokeColor="#E8E0EE">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="F R O N T   O F   S T U D Y   A R E A" android:textSize="10sp" android:textColor="#8B8097" android:gravity="center" android:paddingVertical="10dp" />
      <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#E7DDF2" android:layout_marginHorizontal="28dp" android:layout_marginBottom="12dp" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewSeats" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ENTRY ↑                 ↑ ENTRY" android:textSize="10sp" android:textColor="#9B8DA8" android:gravity="center" android:paddingVertical="8dp" />
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:id="@+id/layoutBottomPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#27755A" android:id="@+id/tvAvailableCount" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap an available seat to make it yours." android:textSize="15sp" android:textColor="#514063" android:id="@+id/textViewSelectedInfo" android:gravity="center" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/buttonReserveSeat" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Reserve this seat" app:cornerRadius="18dp" android:enabled="false" app:icon="@drawable/ic_seat" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep this space quiet. Use headphones for audio." android:textSize="11sp" android:textColor="#8B8097" android:gravity="center" android:layout_marginTop="6dp" />
  </LinearLayout>
</LinearLayout>