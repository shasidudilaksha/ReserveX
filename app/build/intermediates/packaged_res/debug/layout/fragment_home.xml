<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F3F9" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="32dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR CAMPUS LIBRARY" android:textSize="10sp" android:textColor="#857594" android:letterSpacing="0.15" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvGreeting" android:text="Hello, reader" android:textSize="25sp" android:textColor="#292439" android:textStyle="bold" android:layout_marginTop="6dp" />
      </LinearLayout>
      <ImageButton android:id="@+id/btnNotifications" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_notification_button" android:src="@drawable/ic_bell_outline" android:contentDescription="Notifications" app:tint="#55416D" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/libraryHero" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#38284E" android:layout_marginTop="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A LITTLE SPACE. A BIG IDEA." android:textSize="10sp" android:textColor="#CBBBED" android:letterSpacing="0.12" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Make room for your next idea." android:textSize="30sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your books. Your seat. Your quiet moment." android:textSize="14sp" android:textColor="#DDD2EC" android:layout_marginTop="10dp" />
        <ImageView android:id="@+id/libraryIllustration" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="12dp" android:src="@drawable/ill_library_corner" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnFindSeat" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Find my study spot" android:textColor="#38284E" app:backgroundTint="#E5D5FF" app:cornerRadius="16dp" app:icon="@drawable/ic_arrow_forward" app:iconGravity="textEnd" app:iconTint="#38284E" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/searchBar" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginTop="18dp" android:clickable="true" android:focusable="true" android:contentDescription="Search books, seats and rooms">
      <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="18dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_search" app:tint="#6650A4" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Search the library" android:textSize="14sp" android:textColor="#82778D" android:layout_marginStart="12dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plan your library day" android:textSize="20sp" android:textColor="#292439" android:textStyle="bold" android:layout_marginTop="26dp" android:layout_marginBottom="14dp" />
    <LinearLayout android:id="@+id/servicesRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
      <com.google.android.material.card.MaterialCardView android:layout_height="wrap_content" android:id="@+id/cardBooks" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#EAE3F8" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_book" app:tint="#6650A4" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Books" android:textSize="16sp" android:textColor="#302443" android:textStyle="bold" android:layout_marginTop="14dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find a new read" android:textSize="11sp" android:textColor="#706C80" android:layout_marginTop="4dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:layout_height="wrap_content" android:id="@+id/cardSeats" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#E1EFE8" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_seat" app:tint="#6650A4" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seats" android:textSize="16sp" android:textColor="#302443" android:textStyle="bold" android:layout_marginTop="14dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settle into focus" android:textSize="11sp" android:textColor="#706C80" android:layout_marginTop="4dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:layout_height="wrap_content" android:id="@+id/cardRooms" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#F8E9D9" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_meeting_room" app:tint="#6650A4" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rooms" android:textSize="16sp" android:textColor="#302443" android:textStyle="bold" android:layout_marginTop="14dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Think together" android:textSize="11sp" android:textColor="#706C80" android:layout_marginTop="4dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved for you" android:textSize="20sp" android:textColor="#292439" android:textStyle="bold" android:layout_marginTop="26dp" android:layout_marginBottom="14dp" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/upcomingReservationCard" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#FFFFFF" android:visibility="gone" android:clickable="true" android:focusable="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/upcomingType" android:text="YOUR NEXT VISIT" android:textSize="11sp" android:textColor="#756091" android:letterSpacing="0.08" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/upcomingTitle" android:text="" android:textSize="20sp" android:textColor="#302443" android:textStyle="bold" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/upcomingDate" android:text="" android:textSize="14sp" android:textColor="#706C80" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View reservation →" android:textSize="13sp" android:textColor="#6650A4" android:layout_marginTop="16dp" android:textStyle="bold" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/emptyReservationState" android:text="Your next chapter starts here. Reserve a book, a seat or a room above." android:textSize="14sp" android:textColor="#706C80" android:padding="22dp" android:background="@drawable/bg_rounded_card" android:lineSpacingExtra="5dp" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="#EDE7F3" android:layout_marginTop="22dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAUSE. OPEN A BOOK." android:textSize="10sp" android:textColor="#857594" android:letterSpacing="0.1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Good ideas need a little quiet." android:textSize="19sp" android:textColor="#514063" android:layout_marginTop="8dp" android:fontFamily="serif" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>