<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_home_header">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RESERVEX / LIBRARY" android:textSize="11sp" android:textColor="@color/white" android:layout_marginTop="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Books" android:textSize="30sp" android:textColor="@color/white" android:layout_marginTop="12dp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find a book. Make time for a new idea." android:textSize="14sp" android:textColor="@color/white" android:layout_marginTop="12dp" />
  </LinearLayout>
  <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search books" app:startIconDrawable="@android:drawable/ic_menu_search" android:layout_marginHorizontal="24dp">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearch" android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content" />
  </com.google.android.material.textfield.TextInputLayout>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:layout_marginHorizontal="24dp">
    <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup" app:selectionRequired="true" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true">
      <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/chipAll" android:text="All books" android:checked="true" style="@style/Widget.Material3.Chip.Filter" />
      <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/chipAvailable" android:text="Available" style="@style/Widget.Material3.Chip.Filter" />
    </com.google.android.material.chip.ChipGroup>
  </HorizontalScrollView>
  <TextView android:id="@+id/tvResultCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explore the library" android:textSize="18sp" android:textColor="@color/colorTextPrimary" android:layout_marginTop="12dp" android:layout_marginHorizontal="24dp" android:textStyle="bold" />
  <TextView android:id="@+id/tvEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No matches found. Try another search." android:textSize="14sp" android:textColor="@color/colorTextPrimary" android:visibility="gone" android:padding="24dp" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewBooks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginHorizontal="24dp" />
</LinearLayout>